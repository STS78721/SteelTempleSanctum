// SteelTemple Sanctum's Windows resources: the icon (tools/make_icon.py), the manifest, the version shown in
// Explorer's Details tab.
#include <winver.h>

1 ICON "sanctum.ico"
1 24 "sanctum.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SteelTemple"
      VALUE "FileDescription", "SteelTemple Sanctum"
      VALUE "ProductName", "SteelTemple Sanctum"
      VALUE "FileVersion", "1.0.1"
      VALUE "ProductVersion", "1.0.1"
      VALUE "OriginalFilename", "SteelTemple-Sanctum.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
